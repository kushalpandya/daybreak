{
  "imports": {
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/yaml": "jsr:@std/yaml@^1.2.0"
  },
  "tasks": {
    "fetch": "deno run --allow-env --allow-read --allow-write --allow-net=api.open-meteo.com,api.telegram.org --allow-run=gws,gh,glab src/main.ts fetch",
    "agent": "deno run --allow-env --allow-read --allow-write --allow-net=api.open-meteo.com,api.telegram.org --allow-run=gws,gh,glab src/main.ts fetch --format agent",
    "deliver": "deno run --allow-env --allow-read --allow-write --allow-net=api.open-meteo.com,api.telegram.org --allow-run=gws,gh,glab src/main.ts deliver",
    "telegram:chats": "deno run --allow-env --allow-read=.env --allow-net=api.telegram.org src/main.ts telegram chats",
    "doctor": "deno run --allow-env --allow-read --allow-net=api.open-meteo.com,api.telegram.org --allow-run=gws,gh,glab src/main.ts doctor",
    "config:check": "deno run --allow-env --allow-read src/main.ts config check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "check": "deno fmt --check && deno lint && deno check src/main.ts && deno test --allow-env=HOME --allow-read --allow-write",
    "test": "deno test --allow-env=HOME --allow-read --allow-write",
    "compile": "deno compile --output dist/daybreak --allow-env --allow-read --allow-write --allow-net=api.open-meteo.com,api.telegram.org --allow-run=gws,gh,glab src/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
